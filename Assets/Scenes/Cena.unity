  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Onda neutralizada. N\xFAcleo est\xE1vel. Esta\xE7\xE3o \xD4mega seguir\xE1 operacional.\n\n\n\n==== CR\xC9DITOS ===\n\nDire\xE7\xE3o Geral:\nPaulo Guilherme Schnaufer\n\nTrilha Sonora Original:\nThe University Intro\n\n==== AGRADECIMENTOS ESPECIAIS ===\n\nPara o meu amor, Ana Fl\xE1via, que me incentivou mesmo quando parecia imposs\xEDvel fazer um jogo do zero em 53 horas de terminar as inscri\xE7\xF5es\n\nProf. (quase) Dr. Felippe Fernandes pela motiva\xE7\xE3o\n\nProf\xAA. Dr\xAA. Val\xE9ria Delisandre por tamb\xE9m motivar\n\nMain EJ (do qual sou membro) e participou da organiza\xE7\xE3o da SECOMP\n\nPET-Info, CACCOM e outras entidades organizadoras da SECOMP-UEM\n\nComunidade Unity\n\n\nObrigado por jogar!"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: c3dbbea26fbaa95459a8ebcc6d90aecb, type: 2}
