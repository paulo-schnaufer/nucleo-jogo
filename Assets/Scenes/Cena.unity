  leaderboardRowPrefab: {fileID: 8068114782631309649, guid: c4eec5ea85aa01e4b94926c639392cf6, type: 3}
  leaderboardRowsParent: {fileID: 849250774}
  spawner: {fileID: 1969915794}
  playerProgression: {fileID: 1871748934}
  playerHealth: {fileID: 1871748931}
  coreIntegrity: {fileID: 1425451055}
  pontosPorWave: 1000
  pontosPorNivel: 40
  bonusMaximoNucleo: 100
  bonusMaximoJogador: 50
  initialsPanel: {fileID: 1514548372}
  finalScoreLabel: {fileID: 905355183}
  initialsInput: {fileID: 1785958467}
  confirmInitialsButton: {fileID: 910080669}
  initialsSlotLabels:
  - {fileID: 975954603}
  - {fileID: 1506042243}
  - {fileID: 575819832}
  - {fileID: 709803392}
  initialsSlotBackgrounds:
  - {fileID: 1210855738}
  - {fileID: 180928552}
  - {fileID: 113154407}
  - {fileID: 1391470060}
  corSlotInativo: {r: 1, g: 1, b: 1, a: 0.15}
  corSlotAtivo: {r: 0.68, g: 0.42, b: 1, a: 0.35}
  openingPanel: {fileID: 561591560}
  openingText: {fileID: 1556797813}
  openingLines: "N\xDACLEO: \xDAltima Onda\n\n\n\n\n\n\n\n\nEsta\xE7\xE3o \xD4mega. N\xFAcleo inst\xE1vel. Conten\xE7\xE3o em colapso.\nProcessos corrompidos convergem para o n\xFAcleo a cada ciclo.\nVoc\xEA \xE9 o \xFAltimo protocolo de defesa ativo \u2014 n\xE3o deixe o n\xFAcleo cair."
  victoryPanel: {fileID: 1691639316}
  victoryText: {fileID: 873061811}
  victoryThanksLabel: {fileID: 2037562525}
  victoryBlackFade: {fileID: 905447410}
  victoryAndCreditsLines: "Onda neutralizada. N\xFAcleo est\xE1vel. Esta\xE7\xE3o \xD4mega seguir\xE1 operacional.\n\n\n\n==== CR\xC9DITOS ===\n\nDire\xE7\xE3o Geral:\nPaulo Guilherme Schnaufer\n\nTrilha Sonora Original:\nThe University Intro\n\n==== AGRADECIMENTOS ESPECIAIS ===\n\nPara o meu amor, Ana Fl\xE1via, que me incentivou mesmo quando parecia imposs\xEDvel fazer um jogo do zero em 53 horas de terminar as inscri\xE7\xF5es\n\nMinha v\xF3 Nely, que suporta diariamente os meus hiperfocos\n\nAos \xF3timos professores de CC\n\nMain EJ (do qual sou membro)\n\nPET-Info, CACCOM e outras entidades organizadoras da SECOMP-UEM\n\nComunidade Unity"
  defeatPanel: {fileID: 794734115}
  defeatText: {fileID: 1953399993}
  defeatThanksLabel: {fileID: 1732199598}
  defeatBlackFade: {fileID: 718140022}
  defeatAndCreditsLines: "N\xFAcleo comprometido. Conten\xE7\xE3o perdida.\nEsta\xE7\xE3o \xD4mega \u2014 fora do ar.\n\n\n\n==== CR\xC9DITOS ===\n\nDire\xE7\xE3o Geral:\nPaulo Guilherme Schnaufer\n\nTrilha Sonora Original:\nThe University Intro\n\n==== AGRADECIMENTOS ESPECIAIS ===\n\nPara o meu amor, Ana Fl\xE1via, que me incentivou mesmo quando parecia imposs\xEDvel fazer um jogo do zero em 53 horas de terminar as inscri\xE7\xF5es\n\nMinha v\xF3 Nely, que suporta diariamente os meus hiperfocos\n\nAos \xF3timos professores de CC\n\nMain EJ (do qual sou membro)\n\nPET-Info, CACCOM e outras entidades organizadoras da SECOMP-UEM\n\nComunidade Unity"
  hudPanel: {fileID: 417908909}
  coreIntegrityVignette: {fileID: 1932154325}
  creditsMusic: {fileID: 624089582}
  finalCreditsClip: {fileID: 8300000, guid: f2763ff9849ff974abfd1b90ea0eba65, type: 3}
  skipCreditsButtonVictory: {fileID: 342532644}
  skipCreditsButtonDefeat: {fileID: 1785183775}
  skipCreditsKey: 27
