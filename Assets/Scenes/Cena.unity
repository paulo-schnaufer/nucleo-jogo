--- !u!114 &624089579
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 624089577}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 55c20213e32d86242882e9c5386c4a41, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Nucleo.UI.NarrativeUIController
  openingPanel: {fileID: 561591560}
  openingText: {fileID: 1556797813}
  openingLines: "Esta\xE7\xE3o \xD4mega. N\xFAcleo inst\xE1vel. Conten\xE7\xE3o em colapso.\nProcessos corrompidos convergem para o n\xFAcleo a cada ciclo.\nVoc\xEA \xE9 o \xFAltimo protocolo de defesa ativo \u2014 n\xE3o deixe o n\xFAcleo cair."
  victoryPanel: {fileID: 1691639316}
  victoryText: {fileID: 873061811}
  victoryThanksLabel: {fileID: 2037562525}
  victoryBlackFade: {fileID: 905447410}
  victoryAndCreditsLines: "Onda neutralizada. N\xFAcleo est\xE1vel. Esta\xE7\xE3o \xD4mega seguir\xE1 operacional.\n\n\n\n==== CR\xC9DITOS ===\n\nDire\xE7\xE3o Geral:\nPaulo Guilherme Schnaufer\n\nTrilha Sonora Original:\nThe University Intro\n\n==== AGRADECIMENTOS ESPECIAIS ===\n\nPara o meu amor, Ana Fl\xE1via, que me incentivou mesmo quando parecia imposs\xEDvel fazer um jogo do zero em 53 horas de terminar as inscri\xE7\xF5es\n\nProf. (quase) Dr. Felippe Fernandes pela motiva\xE7\xE3o\n\nProf\xAA. Dr\xAA. Val\xE9ria Delisandre por tamb\xE9m motivar\n\nMain EJ (do qual sou membro) e participou da organiza\xE7\xE3o da SECOMP\n\nPET-Info, CACCOM e outras entidades organizadoras da SECOMP-UEM\n\nComunidade Unity"
  defeatPanel: {fileID: 794734115}
  defeatText: {fileID: 1953399993}
  defeatThanksLabel: {fileID: 1732199598}
  defeatBlackFade: {fileID: 718140022}
  defeatAndCreditsLines: "N\xFAcleo comprometido. Conten\xE7\xE3o perdida.\nEsta\xE7\xE3o \xD4mega \u2014 fora do ar.\n\n\n\n==== CR\xC9DITOS ===\n\nDire\xE7\xE3o Geral:\nPaulo Guilherme Schnaufer\n\nTrilha Sonora Original:\nThe University Intro\n\n==== AGRADECIMENTOS ESPECIAIS ===\n\nPara o meu amor, Ana Fl\xE1via, que me incentivou mesmo quando parecia imposs\xEDvel fazer um jogo do zero em 53 horas de terminar as inscri\xE7\xF5es\n\nProf. (quase) Dr. Felippe Fernandes pela motiva\xE7\xE3o\n\nProf\xAA. Dr\xAA. Val\xE9ria Delisandre por tamb\xE9m motivar\n\nMain EJ (do qual sou membro) e participou da organiza\xE7\xE3o da SECOMP\n\nPET-Info, CACCOM e outras entidades organizadoras da SECOMP-UEM\n\nComunidade Unity"
  hudPanel: {fileID: 417908909}
  creditsMusic: {fileID: 624089582}
  finalCreditsClip: {fileID: 8300000, guid: f2763ff9849ff974abfd1b90ea0eba65, type: 3}
